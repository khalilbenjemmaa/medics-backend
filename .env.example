# Copy to .env and fill in. Never commit the real file.

# ---------- database ----------
POSTGRES_DB=practice
POSTGRES_USER=practice
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# ---------- application ----------
SERVER_PORT=8080

# The practice's local timezone. Weekly working hours are interpreted in
# this zone, so a daylight-saving change moves the UTC instant while
# leaving "Monday at nine" where the practitioner expects it.
APP_DOCTOR_TIMEZONE=Europe/Paris

APP_SLOT_DURATION_MINUTES=30
APP_MIN_LEAD_TIME_HOURS=24
APP_MAX_HORIZON_DAYS=90

# ---------- security ----------
# Signing key for admin tokens. At least 32 characters; the application
# refuses to start with anything shorter, because a short key means a
# forgeable signature. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_MINUTES=30

# The operator account, created on first start only. There is
# deliberately no default password: a known default on a system holding
# patient contact details is an open door.
ADMIN_EMAIL=admin@reemamiri.example
ADMIN_PASSWORD=

# Exact origins allowed to call the API. Never "*" — these endpoints
# carry personal data.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# ---------- video meetings (not yet wired) ----------
# No meeting provider is configured. Online appointments are booked and
# confirmed without a link rather than with an invented one.
#
# To add Google Meet: implement MeetingProvider against the Calendar API
# (events.insert with conferenceDataVersion=1), register it as a bean,
# and supply the four values below. NoopMeetingProvider steps aside
# automatically once another MeetingProvider bean exists.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# GOOGLE_CALENDAR_ID=

# ---------------------------------------------------------------
# Email
#
# Off by default. A half-configured mail client that silently drops
# messages is worse than none, because the practice would believe
# patients had been told.
#
# Confirmations go to the address the patient entered when booking.
# Cancelling or rescheduling from the admin sends the matching notice.
# ---------------------------------------------------------------
MAIL_ENABLED=false

# Gmail: MAIL_PASSWORD is an App Password (16 characters, generated
# under 2-Step Verification), never the account password. Gmail also
# rewrites From to the authenticated account, so set MAIL_FROM to match.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_AUTH=true
MAIL_STARTTLS=true
MAIL_FROM=
# The email invites a reply, so this must not be a noreply address.
MAIL_REPLY_TO=

# For local development, point at a capture server such as Mailpit
# (mailpit --smtp 127.0.0.1:1025 --listen 127.0.0.1:8025) and set
# MAIL_HOST=127.0.0.1, MAIL_PORT=1025, MAIL_AUTH=false,
# MAIL_STARTTLS=false. It accepts everything and delivers nothing, so
# real addresses are never contacted.
